# Copia este archivo como .env y ajusta los valores. Nunca subas .env a git.
# Secreto para firmar las cookies de sesión. Genera uno largo y aleatorio, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Puerto del servidor
PORT=3000

# Pon en "true" solo si sirves la app detrás de HTTPS (producción)
COOKIE_SECURE=false
